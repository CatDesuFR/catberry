# Builds the Arch package from the source tree this file sits in:
#   cd packaging/arch && makepkg -si
pkgname=catberry-ac
pkgver=1.1.2
pkgrel=1
pkgdesc='catberry autoclicker: clicks or presses a key at a set rate'
arch=('x86_64')
url='https://github.com/CatDesuFR/catberry/tree/ac'
license=('custom')
depends=('catberry' 'gcc-libs' 'glibc' 'libx11' 'libxtst')
makedepends=('gcc' 'make')
install=catberry-ac.install
options=('!debug')
source=()

build() {
    rm -rf "$srcdir/$pkgname"
    mkdir -p "$srcdir/$pkgname"
    cp -r "$startdir/../../src" "$startdir/../../Makefile" "$srcdir/$pkgname/"
    cd "$srcdir/$pkgname"
    make CXXFLAGS="$CXXFLAGS -Wall -Wextra" catberry-ac
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 catberry-ac "$pkgdir/usr/bin/catberry-ac"
    install -Dm644 "$startdir/../../README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
