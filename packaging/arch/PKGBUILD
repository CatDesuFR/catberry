# Builds the Arch package from the source tree this file sits in:
#   cd packaging/arch && makepkg -si
pkgname=catberry-cbmm
pkgver=1.1.7
pkgrel=1
pkgdesc="Catberry's Mod Menu for Geometry Dash (Geode): catberry cbmm load"
arch=('x86_64')
url='https://github.com/CatDesuFR/catberry/tree/cbmm'
license=('custom')
depends=('catberry')
makedepends=('gcc' 'make')
options=('!debug')
source=()

build() {
    rm -rf "$srcdir/$pkgname"
    mkdir -p "$srcdir/$pkgname/packaging/arch"
    cp -r "$startdir/../../src" "$startdir/../../geode" "$startdir/../../Makefile" "$srcdir/$pkgname/"
    cp "$startdir/PKGBUILD" "$srcdir/$pkgname/packaging/arch/"
    make -C "$srcdir/$pkgname" catberry-cbmm
}

package() {
    install -Dm755 "$srcdir/$pkgname/catberry-cbmm" "$pkgdir/usr/bin/catberry-cbmm"
    install -Dm644 "$startdir/../../README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
