# Builds the Arch package from the source tree this file sits in:
#   cd packaging/arch && makepkg -si
pkgname=catberry
pkgver=1.3.8
pkgrel=1
pkgdesc='catberry launcher: runs the catberry autoclicker, macro tools and wallpaper manager'
arch=('x86_64')
url='https://github.com/CatDesuFR/catberry'
license=('custom')
depends=('gcc-libs' 'glibc')
makedepends=('gcc' 'make')
optdepends=('catberry-ac: the autoclicker (catberry ac)'
            'catberry-roofce: the wallpaper manager (catberry roofce)'
            'catberry-mtools: the macro recorder and hotkey macros (catberry mtools, -config)')
install=catberry.install
options=('!debug')
source=()

build() {
    rm -rf "$srcdir/$pkgname"
    mkdir -p "$srcdir/$pkgname"
    cp -r "$startdir/../../src" "$startdir/../../Makefile" "$srcdir/$pkgname/"
    cd "$srcdir/$pkgname"
    make CXXFLAGS="$CXXFLAGS -Wall -Wextra" catberry
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 catberry "$pkgdir/usr/bin/catberry"
    # Shared by the tools: lets them create their virtual mouse/keyboard.
    install -Dm644 "$startdir/70-catberry-uinput.rules" "$pkgdir/usr/lib/udev/rules.d/70-catberry-uinput.rules"
    install -Dm644 "$startdir/../../README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
