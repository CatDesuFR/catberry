# Builds the Arch package from the source tree this file sits in:
#   cd packaging/arch && makepkg -si
pkgname=catberry-vskm
pkgver=1.0.2
pkgrel=1
pkgdesc="Vencord plugins for Vesktop: catberry vskm load NAME"
arch=('x86_64')
url='https://github.com/CatDesuFR/catberry/tree/vskm'
license=('GPL-3.0-or-later')
depends=('catberry')
optdepends=('vesktop: the Discord client the plugins are for')
makedepends=('gcc' 'make')
options=('!debug')
source=()

build() {
    rm -rf "$srcdir/$pkgname"
    mkdir -p "$srcdir/$pkgname/packaging/arch"
    cp -r "$startdir/../../src" "$startdir/../../third_party" "$startdir/../../vencord" "$startdir/../../Makefile" "$srcdir/$pkgname/"
    cp "$startdir/PKGBUILD" "$srcdir/$pkgname/packaging/arch/"
    make -C "$srcdir/$pkgname" catberry-vskm
}

package() {
    install -Dm755 "$srcdir/$pkgname/catberry-vskm" "$pkgdir/usr/bin/catberry-vskm"
    for f in "$srcdir/$pkgname"/vencord/*; do
        install -Dm644 "$f" "$pkgdir/usr/share/catberry-vskm/vencord/$(basename "$f")"
    done
    install -Dm644 "$startdir/../../README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
