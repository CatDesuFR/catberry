post_install() {
    udevadm control --reload-rules 2>/dev/null
    udevadm trigger --name-match=uinput 2>/dev/null
    echo ":: catberry installed. Run: catberry -help"
    echo ":: Install the tools separately: catberry-ac (autoclicker), catberry-mtools (macros)."
}

post_upgrade() {
    post_install
}
